// F5 loads the extension from package.json "main" (dist/extension.js, the
// esbuild bundle). Build it first with `npm run vscode:pack:dev` or
// `node esbuild.js`; without dist/ the extension host has nothing to run.
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			]
		}
	]
}
